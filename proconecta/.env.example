# Copie este arquivo para ".env" (sem o ".example") e cole a connection string
# que o Neon te dá, terminando em ?sslmode=require

DATABASE_URL=postgresql://usuario:senha@ep-exemplo.neon.tech/proconecta?sslmode=require

# Opcional — segredo usado para assinar o token de login.
# Se não definir, usa um valor padrão (troque em produção).
PROCONECTA_SECRET=escolha-uma-frase-longa-e-aleatoria
